# Bazel's convenience symlinks, named after the output tree and the workspace
# directory — which is the checkout's own name, so match the prefix.
bazel-*
.bazelrc.user
build
cmake-build
llvm-project
llvm-build
.vscode
.cache
.idea/
**/__pycache__
*.whl
**/*.egg-info/

# The bzlmod consumer fixture resolves from scratch on every CI run; its lock
# would be one more file to keep current for no check it performs.
bazel/bzlmod_consumer/MODULE.bazel.lock

# Standalone module: this file is not the repository root's .bazelrc, and the
# root's does not reach a separate workspace. The build flags below are the
# root's, repeated so that the actions this lane runs hash the same as the ones
# stablehlo's own lanes run and hit the shared cache instead of rebuilding LLVM.
common --enable_bzlmod
common --noenable_workspace

build --cxxopt=-std=c++17
build --host_cxxopt=-std=c++17
# LLVM builds without RTTI; anything linking it has to match.
build --cxxopt=-fno-rtti
build --host_cxxopt=-fno-rtti
build --incompatible_enable_cc_toolchain_resolution
build --incompatible_strict_action_env
build --fission=dbg
build --nobuild_runfile_links
test --nobuild_runfile_links
build --nolegacy_external_runfiles
test --nolegacy_external_runfiles

# Not the root's `--features=layering_check`: that would demand this fixture
# declare @llvm-project directly, which is exactly the dependency it is showing
# a consumer does not need.

load("@rules_cc//cc:cc_test.bzl", "cc_test")

# How a consumer actually uses stablehlo: these are the three targets
# riscv-witness' own BUILD files name.
#
# There is no `@llvm-project` in the deps because a module extension's
# repositories are not re-exported: stablehlo's MLIR is reachable through this
# target's own dependencies, but a consumer with MLIR in its own sources — as
# riscv-witness has — declares llvm-project for itself, and gets the same
# repository because it comes from prime_ir's extension either way.
cc_test(
    name = "consume_stablehlo_test",
    size = "small",
    srcs = ["consume_stablehlo_test.cc"],
    deps = [
        "@com_google_googletest//:gtest_main",
        "@stablehlo//:register",
        "@stablehlo//:stablehlo_ops",
        "@stablehlo//:stablehlo_passes",
    ],
)
